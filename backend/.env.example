# PostgreSQL database built by `npm run db:reset` (schema + V2 data + demo accounts)
DATABASE_URL=postgresql://localhost/orbit
# The website and API: http://localhost:5055
PORT=5055
# Put a long random string here (signs the sign-in tokens)
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_HOURS=12
# Salem's V2 engine service (npm run engine)
ENGINE_URL=http://127.0.0.1:5080
# Planning durations for new optimizer runs: booked (what a hospital knows) or v2 (as the V2 notebook)
DEFAULT_PLAN_MODE=booked
